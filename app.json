{
  "expo": {
    "name": "haru record",
    "slug": "haru-record",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "harurecord",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.emtc.harurecord",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "施術の写真を記録するためにフォトライブラリへのアクセスが必要です。",
        "NSCameraUsageDescription": "施術の写真を撮影するためにカメラへのアクセスが必要です。",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ja",
        "CFBundleLocalizations": [
          "ja",
          "en",
          "zh-Hans",
          "zh-Hant-TW",
          "ko"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "施術の写真を記録するためにフォトライブラリへのアクセスが必要です。"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2989531368920692~2942555815",
          "iosAppId": "ca-app-pub-2989531368920692~2942555815"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "より関連性の高い広告を表示するために使用されます。広告の表示に同意しない場合も引き続きアプリをご利用いただけます。"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37b33f2e-19f9-42dc-876a-2ed3ed388a7a"
      }
    },
    "owner": "emtcdv"
  }
}
